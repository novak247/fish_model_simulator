<launch>

  <group ns="fish_model_simulator">
    <node name="filtration_node" pkg="fish_model_simulator" type="filtration" output="screen">
      <param name="config" value="$(find fish_model_simulator)/config/filtration.yaml" />
      <remap from="/fish_model_simulator/filtration_node/filtration_activation_in" to="/fish_model_simulator/activate_filtration" />
    </node>
  </group>


</launch>
